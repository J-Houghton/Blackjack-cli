<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="blackjack.Tests" />
  </ItemGroup>

  <!-- keys.ini lives next to the solution; a copy beside the program covers running from Visual Studio. -->
  <ItemGroup>
    <None Include="..\keys.ini" Link="keys.ini" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
